<?xml version="1.0" encoding="utf-8"?>
<org.ippazio.privacylowvisionpdf.FirstRunFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/pdf_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.ippazio.privacylowvisionpdf.ReflowListView
        android:id="@+id/reflow_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clipToPadding="false"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingTop="88dp"
        android:paddingBottom="48dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="28dp"
        android:paddingTop="88dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/product_name"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/home_hint"
                android:textSize="20sp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/menu_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start|top"
        android:background="?attr/colorSurface"
        android:elevation="6dp"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="84dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/document_open_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_document_button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="@string/open_document"
                    android:textSize="15sp"
                    app:icon="@drawable/ic_open_document"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="34dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exit_program_button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/close_program"
                    android:text=""
                    app:icon="@drawable/ic_exit_program"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="30dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/search_button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/search_text"
                    android:text=""
                    android:visibility="gone"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/document_menu_controls"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/zoom"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/zoom_out_button"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/zoom_out"
                    android:text="−"
                    android:textSize="26sp" />

                <Button
                    android:id="@+id/zoom_in_button"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/zoom_in"
                    android:text="+"
                    android:textSize="26sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/document_menu_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/reflow_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:text="@string/text_reflow"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/theme_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/theme"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="@string/theme_system"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="@string/theme_light"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="@string/theme_dark"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/theme_high_contrast"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="@string/theme_high_contrast"
                    android:textSize="18sp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <org.ippazio.privacylowvisionpdf.HelpButton
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:text="@string/help"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/language_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/language"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/menu_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="start|top"
        android:layout_margin="12dp"
        android:contentDescription="@string/menu_button_description"
        android:elevation="8dp"
        android:minWidth="64dp"
        android:minHeight="64dp"
        android:padding="0dp"
        android:text="☰"
        android:textSize="30sp" />

</org.ippazio.privacylowvisionpdf.FirstRunFrameLayout>
